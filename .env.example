# OpenRouter API Configuration (REQUIRED for AI suggestions)
# Powers the AI pattern generation — e.g. "(animals)" → dog, tiger, wolf.
# Without it, only literal slash patterns like "(com/io)" work.
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenRouter model override (OPTIONAL)
# Any model that supports structured outputs works. See https://openrouter.ai/models
# Default: anthropic/claude-sonnet-5  •  Cheaper: google/gemini-3.5-flash
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Ranking model override (OPTIONAL)
# Powers the "AI pick" panel, which ranks the domains that came back available.
# That is an easier job than inventing names, so it defaults to a cheaper model.
# OPENROUTER_RANKER_MODEL=google/gemini-3.1-flash-lite

# Domainr API Configuration (OPTIONAL)
# Used only as a final fallback for availability checks. RDAP + WHOIS cover most
# TLDs without it; add it to improve accuracy on TLDs those miss.
# Get your key from: https://rapidapi.com/domainr/api/domainr
DOMAINR_RAPIDAPI_KEY=your_rapidapi_key_here

# Landing-only mode (OPTIONAL)
# Set to "true" to turn a deployment into a public showcase: it shows a
# "deploy your own" landing page and disables the AI search API, so strangers
# can't spend your OpenRouter credits. Leave unset to run the full, working app.
# NEXT_PUBLIC_LANDING_ONLY=true
